
#include <stdio.h>

int graph[100][100];
int visited[100];
int n;

void DFS(int v) {
    printf("%d ", v);
    visited[v] = 1;

    for (int i = 0; i < n; i++) {
        if (graph[v][i] == 1 && visited[i] == 0)
            DFS(i);
    }
}

void BFS(int start) {
    int queue[100], front = 0, rear = 0;
    int seen[100] = {0};

    queue[rear++] = start;
    seen[start] = 1;

    while (front < rear) {
        int v = queue[front++];
        printf("%d ", v);

        for (int i = 0; i < n; i++) {
            if (graph[v][i] == 1 && seen[i] == 0) {
                queue[rear++] = i;
                seen[i] = 1;
            }
        }
    }
}

int main() {
    int edges, u, v, start;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    if (n < 1 || n > 100) {
        printf("Invalid number of vertices");
        return 0;
    }

    printf("Enter number of edges: ");
    scanf("%d", &edges);

    if (edges < 0 || edges > n * (n - 1) / 2) {
        printf("Invalid number of edges");
        return 0;
    }

    for (int i = 0; i < edges; i++) {
        printf("Enter edge (u v): ");
        scanf("%d %d", &u, &v);

        if (u < 0 || u >= n || v < 0 || v >= n) {
            printf("Invalid vertex");
            return 0;
        }

        graph[u][v] = 1;
        graph[v][u] = 1;
    }

    printf("Enter starting vertex: ");
    scanf("%d", &start);

    if (start < 0 || start >= n) {
        printf("Invalid starting vertex");
        return 0;
    }

    for (int i = 0; i < n; i++)
        visited[i] = 0;

    printf("DFS: ");
    DFS(start);

    printf("\nBFS: ");
    BFS(start);

    return 0;
}
