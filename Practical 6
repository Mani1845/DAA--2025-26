
#include <stdio.h>
#include <limits.h>

int main() {
    int p[101];
    long long dp[101][101];
    int n;

    printf("Enter number of matrices: ");
    scanf("%d", &n);

    if (n < 1 || n > 100) {
        printf("Invalid number of matrices");
        return 0;
    }

    printf("Enter matrix dimensions: ");
    for (int i = 0; i <= n; i++) {
        scanf("%d", &p[i]);

        if (p[i] <= 0) {
            printf("Dimensions must be positive");
            return 0;
        }
    }

    for (int i = 1; i <= n; i++)
        dp[i][i] = 0;

    for (int len = 2; len <= n; len++) {
        for (int i = 1; i <= n - len + 1; i++) {
            int j = i + len - 1;
            dp[i][j] = LLONG_MAX;

            for (int k = i; k < j; k++) {
                long long cost = dp[i][k] + dp[k + 1][j]
                               + 1LL * p[i - 1] * p[k] * p[j];

                if (cost < dp[i][j])
                    dp[i][j] = cost;
            }
        }
    }

    printf("Minimum multiplication cost: %lld\n", dp[1][n]);

    return 0;
}
