
#include <stdio.h>

long long iterativeFactorial(int n) {
    long long fact = 1;

    for (int i = 1; i <= n; i++)
        fact = fact * i;

    return fact;
}

long long recursiveFactorial(int n) {
    if (n == 0 || n == 1)
        return 1;

    return n * recursiveFactorial(n - 1);
}

int main() {
    int n;

    printf("Enter a number (0 to 20): ");
    scanf("%d", &n);

    if (n < 0 || n > 20) {
        printf("Invalid input");
        return 0;
    }

    printf("Factorial using iteration: %lld\n",
           iterativeFactorial(n));

    printf("Factorial using recursion: %lld\n",
           recursiveFactorial(n));

    return 0;
}
